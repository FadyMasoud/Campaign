# =============================================================================
# campaign-portal — environment template
#
# Copy this file to `.env.local` and fill in the values.
#   .env.example  -> committed to git. NAMES ONLY. Never a real value.
#   .env.local    -> git-ignored. Your real keys. Never commit, never paste.
#
# The rule that keeps this safe is a NAMING rule, not a filing rule:
# Next.js inlines any variable starting with NEXT_PUBLIC_ into the JavaScript
# it ships to the browser. Anyone can read it with View Source. Everything
# without that prefix stays on the server and is never sent to the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC — deliberately visible in the browser. This is normal and safe.
# -----------------------------------------------------------------------------

# Supabase Dashboard -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Dashboard -> Project Settings -> API Keys
#   Newer projects label this "Publishable key" (starts with sb_publishable_).
#   Older projects label it "anon / public" (a long JWT starting with eyJ).
# Either works. It identifies the PROJECT, not a person. It grants no access
# on its own: every request it makes is still filtered by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# SERVER ONLY — never add the NEXT_PUBLIC_ prefix to anything below this line.
# -----------------------------------------------------------------------------

# Supabase Dashboard -> Project Settings -> API Keys -> "Secret key"
# (older projects: "service_role"). Reveal it once, paste it into .env.local,
# and do not keep it anywhere else.
#
# DANGER: this key BYPASSES Row Level Security completely. It can read and
# write every brand's data. It exists so trusted server code can do admin work
# (seeding, webhooks). If it ever reaches the browser or a public repo, every
# guarantee in this project is void and the key must be rotated immediately.
SUPABASE_SERVICE_ROLE_KEY=

# --- Messaging provider (Dispatcher) -----------------------------------------
# Base URL and docs are published in the brief, so they are configuration, not
# secrets. Kept server-side anyway: the browser has no reason to know them, and
# the send must never originate from the browser.
#   Docs: https://dispatcher-production-72fc.up.railway.app/v1/docs
DISPATCHER_BASE_URL=https://dispatcher-production-72fc.up.railway.app

# Your unique provider API key. Per the brief it arrives in the EMAIL that sent
# the task, NOT in the PDF. Server-only, never NEXT_PUBLIC_.
DISPATCHER_API_KEY=
